# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Fonts never change under the same filename, so they can be cached for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their filenames when replaced, so a shorter cache keeps updates visible.
/images/*
  Cache-Control: public, max-age=604800
